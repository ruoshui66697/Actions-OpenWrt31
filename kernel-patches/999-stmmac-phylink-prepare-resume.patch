 /**
+ * phylink_prepare_resume() - prepare to resume a network device
+ * @pl: a pointer to a &struct phylink returned from phylink_create()
+ *
+ * Optional, but if called must be called prior to phylink_start().
+ *
+ * stmmac re-attaches the PHY in stmmac_init_phy() before this hook runs,
+ * and phy_attach_direct() has already resumed it, so BMCR_PDOWN is clear
+ * by the time we get here. IEEE 802.3 22.2.4.1.5 nevertheless
+ * allows a PHY up to 500ms for its receive clock to meet the spec after
+ * PDOWN is cleared. stmmac_hw_setup() polls the DMA software-reset bit
+ * for only 200ms and runs before phylink_start(), so wait here with no
+ * runtime condition that the preceding attach may have invalidated.
+ */
+void phylink_prepare_resume(struct phylink *pl)
+{
+	ASSERT_RTNL();
+	(void)pl;
+
+	msleep(500);
+}
+EXPORT_SYMBOL_GPL(phylink_prepare_resume);
+
