 /**
+ * phylink_prepare_resume() - bring a re-attached PHY up before MAC setup
+ * @pl: a pointer to a &struct phylink returned from phylink_create()
+ *
+ * Optional, but if called must be called after the PHY has been attached
+ * and before the MAC performs its DMA software reset.
+ *
+ * On a MAC which takes its MII clock from the PHY, DMA_MODE.SWR only
+ * self-clears once that clock is running. stmmac re-attaches the PHY in
+ * stmmac_init_phy(), and phy_attach_direct() clears BMCR_PDOWN, but
+ * autonegotiation is normally restarted only by phylink_start(), which
+ * runs after stmmac_hw_setup(). On an interface reopen the PHY is left
+ * at its reset defaults (no link), so the clock never comes back and the
+ * DMA reset times out. Restart AN and wait for the link here instead.
+ * A link already established (e.g. handed over by a bootloader) is left
+ * alone: its clock is running and renegotiating it would be harmful.
+ */
+void phylink_prepare_resume(struct phylink *pl)
+{
+	struct phy_device *phydev = pl->phydev;
+	int bmsr, ret, i;
+
+	ASSERT_RTNL();
+
+	if (!phydev)
+		return;
+
+	bmsr = phy_read(phydev, MII_BMSR);
+	if (bmsr < 0 || bmsr == 0xffff) {
+		phylink_warn(pl, "cannot read MII_BMSR (%d)\n", bmsr);
+		return;
+	}
+
+	if (bmsr & BMSR_LSTATUS)
+		return;
+
+	ret = phy_restart_aneg(phydev);
+	if (ret < 0) {
+		phylink_warn(pl, "cannot restart autonegotiation (%d)\n", ret);
+		return;
+	}
+
+	/* BMSR link status is latch-low: read repeatedly so that the first
+	 * (stale) low value is consumed. 60 x 50ms = 3s is ample for
+	 * 802.3 autonegotiation to complete. On timeout we only warn and
+	 * let the normal MAC setup path run, keeping the failure shape
+	 * comparable with an unpatched kernel.
+	 */
+	for (i = 0; i < 60; i++) {
+		msleep(50);
+		bmsr = phy_read(phydev, MII_BMSR);
+		if (bmsr < 0)
+			break;
+		if (bmsr & BMSR_LSTATUS) {
+			phylink_info(pl, "PHY link up after %d ms (BMSR=0x%04x)\n",
+				     (i + 1) * 50, bmsr);
+			return;
+		}
+	}
+
+	phylink_warn(pl, "PHY link still down after AN restart (BMSR=0x%04x)\n",
+		     bmsr);
+}
+EXPORT_SYMBOL_GPL(phylink_prepare_resume);
+
